# ==========================================================================
# dashboard_juridico — variáveis de ambiente (EXEMPLO)
# Copie para .env e ajuste. .env NUNCA vai para o Git.
# ==========================================================================

# Raiz do repositório documental do Escritório Jurídico — SOMENTE LEITURA.
# Nada neste projeto tem permissão de escrever dentro deste caminho.
# Versao publica: a fonte ficticia gerada por examples/gerar_fonte_ficticia.py.
# Caminho relativo resolve a partir da raiz do projeto.
PROG_SOURCE_ROOT=examples/fonte-ficticia

# Nome do arquivo de índice na raiz da fonte.
PROG_INDEX_FILENAME=00 Indice.xlsx

# Diretórios derivados, dentro deste projeto (relativos à raiz do repo).
PROG_DATA_RAW=data/raw
PROG_DATA_PROCESSED=data/processed
PROG_DATA_CACHE=data/cache
PROG_DUCKDB_PATH=data/processed/prog.duckdb

# API
PROG_API_HOST=127.0.0.1
PROG_API_PORT=8000
PROG_LOG_LEVEL=INFO

# Frontend (Vite) — prefixo VITE_ é obrigatório para chegar ao browser
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
